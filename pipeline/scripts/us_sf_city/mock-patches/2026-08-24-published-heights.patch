+
+    def med(i):
+        r = RAW[i]
+        h = r["hmed"]
+        if h is None: h = r["hmean"]
+        if h is None: h = r["hmax"]
+        return (h or 0) / 100.0
+
+    out, st = {}, _c.Counter()
+    for t in rows:
+        pn = (t.get("mapblocklot") or "").strip()
+        try:
+            m = float(t["height_ft"]) * 0.3048
+        except (TypeError, ValueError, KeyError):
+            st["no published height"] += 1; continue
+        idx = by_pn.get(pn)
+        if not idx:
+            st["no footprint on that parcel"] += 1; continue
+        near = [i for i in idx if med(i) >= 0.5 * m]
+        if near:
+            pick = min(near, key=lambda i: abs(med(i) - m))
