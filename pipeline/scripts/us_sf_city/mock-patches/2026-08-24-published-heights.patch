+def published_heights(RAW):
+    """`5kya-mfst` height_ft -> {index into RAW: metres}, joined and RESOLVED.
+
+    The register keys on `mapblocklot`, which is the parcel number this file
+    already joins footprints to. Most parcels carry one footprint and the row
+    is unambiguous. Where a parcel carries several — a tower on a podium — the
+    published height belongs to ONE of them, and picking `max(area)` gives it
+    to the podium, which is how Spear Tower came to be drawn at 27.8 m against
+    a published 172.2.
+
+    THE RESOLUTION IS PUBLISHED AGAINST PUBLISHED. The footprint whose own
+    LiDAR median is nearest the published height takes it, provided it reaches
+    half of it — the tower's own returns are in the grid even when the median
+    over the whole site is not. Where NO footprint reaches half (the building
+    postdates the 2010 flight, so none of it is in the grid at all), the
+    largest takes it, because that is the only thing left to say and the
+    alternative is to leave a 326 m building off the map.
+    """
+    import collections as _c
+    seed = os.path.join(ROOT, "..", "..", "pipeline", "scripts", "us_sf_city",
