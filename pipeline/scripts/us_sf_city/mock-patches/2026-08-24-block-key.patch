+# ── THE BLOCK KEY ───────────────────────────────────────────────────────────
+# The parcel join above was fixed once (mblr[2:9] truncates a lettered block).
+# The BLOCK key was not, and it is the same defect one level up: `pn[:4]` is
+# only the assessor block when the block is four characters. 401 of the city's
+# 5,413 published blocks are five — four digits and a letter — so `pn[:4]`
+# pools 4591A, 4591B, 4591C and 4591D into one bucket called "4591".
+#
+# That is how the 25th-percentile year of 4591C's 523 Hunters Point Shipyard
+# Phase 1 CONDOMINIUM rows (2015-2023) came to date an 11,719 m2, 52 m Navy
+# industrial hall on 4591A to 2015. See pipeline/scripts/us_sf_city/DATA-TRUTH.md.
+#
+# The block is PUBLISHED: acdm-wktn ships `block_num` and `lot_num` as separate
+# columns, so for any parcel in the fabric the answer is read, not inferred.
+# For a parcel that is not in the fabric — 6,155 footprints join no active
+# parcel — the longest published block prefix is used instead. Measured against
+# the fabric's own block_num that rule is right on 227,936 of 227,937 parcels;
+# the single miss is 4991COM (block 4991, lot COM), read as 4991C because 4991C
+# is also a real block. Hence the order below: the LOOKUP first, the prefix rule
+# only where there is nothing to look up.
+
+
+def block_index(parcel_rows):
+    """acdm-wktn rows -> (pn -> block_num, {published block ids}).
+
+    `parcel_rows` is geo/cache/parcels.json: the active parcel fabric, one row
+    per parcel, carrying `block_num` and `lot_num`.
+    """
+    pn2b = {}
+    blocks = set()
+    for r in parcel_rows:
+        b = r.get("block_num") or ""
+        l = r.get("lot_num") or ""
+        if b and l:
+            blocks.add(b)
+            pn2b[b + l] = b
+    return pn2b, blocks
+
+
+def resolve_block(pn, index):
+    """The published assessor block this parcel number sits on, or ''.
+
+    Returns '' rather than a guess when no published block matches, because a
+    footprint with no block has no block fallback year either, and the caller
+    must be able to say so. Never returns pn[:4] blindly.
+    """
+    if not pn:
+        return ""
+    pn2b, blocks = index
+    b = pn2b.get(pn)
+    if b:
+        return b
+    # not in the fabric: the longest published prefix. Blocks are 4 or 5 chars.
+    for n in (5, 4):
+        if pn[:n] in blocks:
+            return pn[:n]
+    return ""
