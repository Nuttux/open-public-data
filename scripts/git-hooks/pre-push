#!/usr/bin/env bash
# Committed pre-push hook for the Qipu pipeline.
#
# Install once (per clone):   git config core.hooksPath scripts/git-hooks
#
# 1. Always: compile-check the export + sync scripts (fast, creds-free).
# 2. If BigQuery creds are present AND the push touches pipeline/ or
#    website/public/data/: run the tolerant Paris export-parity gate, so a
#    refactor can't silently change a published number. Skipped (with a notice)
#    when no creds, when nothing in scope changed, or when SKIP_PARITY=1.
#
# Two lessons are encoded here, both from 2026-08-24:
#   - A gate that runs on every push, including ones that touch no pipeline
#     file, teaches the reader to reach for SKIP_PARITY=1 by reflex. So we scope
#     it: all export code lives under pipeline/, all output under
#     website/public/data/ — a push touching neither cannot move a number.
#   - "Could not check" is not "a number changed". check_export_parity.sh exits
#     3 when it could not regenerate (missing mart, expired creds, no network)
#     and 1 only on a real difference. Blocking on 3 is a false accusation, and
#     false accusations are how the gate lost its authority.
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
fail=0
ZERO=0000000000000000000000000000000000000000

echo "pre-push: py_compile export + sync scripts…"
if ! python3 -m py_compile "$REPO"/pipeline/scripts/export/*.py "$REPO"/pipeline/scripts/sync/*.py; then
  echo "  ✗ compile failed" >&2
  fail=1
fi

# --- Is anything in the gate's blast radius being pushed? --------------------
# stdin gives one line per pushed ref: <local_ref> <local_sha> <remote_ref> <remote_sha>
in_scope=""
saw_ref=0
while read -r _lref lsha _rref rsha; do
  saw_ref=1
  [ "$lsha" = "$ZERO" ] && continue                    # branch deletion
  if [ "$rsha" = "$ZERO" ]; then                       # new branch on the remote
    base="$(git merge-base origin/main "$lsha" 2>/dev/null || true)"
    [ -z "$base" ] && { in_scope="unknown"; break; }   # no base → don't guess, run it
    range="$base..$lsha"
  else
    range="$rsha..$lsha"
  fi
  if [ -n "$(git diff --name-only "$range" -- pipeline/ website/public/data/ 2>/dev/null)" ]; then
    in_scope="yes"
  fi
done
# Hook invoked by hand (no ref lines on stdin) → run the gate rather than
# skipping silently. Only "read refs, none in scope" means genuinely skippable.
[ "$saw_ref" = "0" ] && in_scope="unknown"

if [ "${SKIP_PARITY:-0}" = "1" ]; then
  echo "pre-push: export parity skipped (SKIP_PARITY=1)."
elif [ -z "$in_scope" ]; then
  echo "pre-push: export parity skipped (push touches neither pipeline/ nor website/public/data/)."
elif [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] || [ -f "$HOME/.config/gcloud/application_default_credentials.json" ]; then
  echo "pre-push: tolerant Paris export parity…"
  bash "$REPO/pipeline/scripts/export/check_export_parity.sh"
  rc=$?
  # 0 = identical · 1 = a number really moved · 2 = refused (dirty data tree,
  # it restores via `git checkout` and won't clobber your work) · 3 = could not
  # regenerate. Only 1 is an accusation; 2 and 3 mean the gate has no opinion.
  case "$rc" in
    0) ;;
    2|3) echo "  ⚠ export parity: COULD NOT CHECK (see above). Not a parity failure — push allowed." >&2 ;;
    *) echo "  ✗ export parity: a published number changed. Review before pushing." >&2; fail=1 ;;
  esac
else
  echo "pre-push: export parity skipped (no BigQuery creds). Run pipeline/scripts/export/check_export_parity.sh manually, or in CI."
fi

exit "$fail"
